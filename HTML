      margin:
        auto;
    }

    .etiqueta {

      display:
        inline-block;

      background:
        var(--rojo);

      padding:
        8px 15px;

      border-radius:
        25px;

      font-size:
        .82rem;

      font-weight:
        bold;

      margin-bottom:
        18px;

      text-transform:
        uppercase;

      letter-spacing:
        1px;
    }

    .hero h1 {

      max-width:
