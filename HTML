      padding:
        10px 12px;

      border-radius:
        10px;
    }

    .time-box strong {

      display:
        block;

      font-size:
        1.6rem;

      color:
        white;
    }

    .time-box span {

      font-size:
        .7rem;

      color:
        #aaa;

      text-transform:
        uppercase;
    }

