        center;

      margin-bottom:
        35px;
    }

    .seccion-titulo small {

      color:
        var(--rojo);

      text-transform:
        uppercase;

      letter-spacing:
        2px;

      font-weight:
        bold;
    }

    .seccion-titulo h2 {

      font-size:
        clamp(2rem, 4vw, 3rem);

      margin-top:
        8px;
    }

    /* =====================================
       PRODUCTO
    ====================================== */

    .producto {

      display:
        grid;

      grid-template-columns:
        1.1fr .9fr;

      gap:
        45px;

      align-items:
        center;
    }

    .visor {

      min-height:
        550px;

      background:
        radial-gradient(
          circle at center,
          #ffffff 0%,
          #e8e8e8 70%
