        var(--rojo);
    }

    nav a {
      color:
        white;

      text-decoration:
        none;

      margin-left:
        22px;

      font-weight:
        bold;

      font-size:
        .95rem;
    }

    nav a:hover {
      color:
        #ff536c;
    }

    /* =====================================
       HERO
    ====================================== */

    .hero {

      background:
        linear-gradient(
          90deg,
          rgba(0, 0, 0, .94) 0%,
          rgba(0, 0, 0, .78) 45%,
          rgba(0, 0, 0, .35) 100%
