    }

    .btn-secondary {

      border:
        2px solid white;

      color:
        white;
    }

    .btn-secondary:hover {

      background:
        white;

      color:
        black;
    }

    /* =====================================
       CONTADOR
    ====================================== */

    .countdown-section {

      background:
        #111;

      color:
        white;

      padding:
        25px 5%;

      text-align:
        center;
    }

    .countdown-title {

      font-size:
        .9rem;

      text-transform:
        uppercase;

      letter-spacing:
        2px;

      color:
        #bbb;

      margin-bottom:
        10px;
    }

    #countdown {

      display:
        flex;

      justify-content:
        center;

      gap:
        12px;

      flex-wrap:
        wrap;
    }

    .time-box {

      background:
        #202020;

      border:
        1px solid #333;

      min-width:
