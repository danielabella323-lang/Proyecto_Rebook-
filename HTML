        </span>

      </div>


      <div class="time-box">

        <strong id="minutes">
          00
        </strong>

        <span>
          Minutos
        </span>

      </div>


      <div class="time-box">

        <strong id="seconds">
          00
        </strong>

        <span>
          Segundos
        </span>

      </div>

    </div>

  </section>


  <main>


    <!-- =====================================
         PRODUCTO
    ====================================== -->

    <section id="producto">


      <div class="seccion-titulo">

        <small>
          Producto destacado
        </small>

        <h2>
          Reebok Men's Rapid Strike Shoes
        </h2>

      </div>


