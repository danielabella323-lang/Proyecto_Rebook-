        auto;

      display:
        flex;

      align-items:
        center;

      justify-content:
        space-between;

      gap:
        20px;
    }

    .logo {
      font-size:
        1.7rem;

      font-weight:
        900;

      letter-spacing:
        1px;
    }

    .logo span {
