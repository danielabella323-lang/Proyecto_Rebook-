      border-radius:
        24px;

      overflow:
        hidden;

      position:
        relative;

      box-shadow:
        var(--sombra);

      border:
        1px solid #ddd;
    }

    model-viewer {

      width:
        100%;

      height:
        550px;

      background:
        transparent;
    }

    .ar-button {

      position:
        absolute;

      left:
        50%;

      bottom:
        22px;

      transform:
        translateX(-50%);

      border:
        none;

      border-radius:
        30px;

      padding:
        15px 26px;

      background:
        var(--rojo);

      color:
        white;

      font-size:
        1rem;

      font-weight:
        bold;

      cursor:
        pointer;

      box-shadow:
        0 8px 25px
        rgba(227, 24, 55, .35);

      white-space:
        nowrap;
    }

    .ar-button:hover {

      background:
        var(--rojo-hover);
    }

    .ar-badge {

      position:
        absolute;

      top:
        20px;

      left:
        20px;

      background:
        rgba(0, 0, 0, .82);

      color:
        white;

      padding:
        8px 13px;

      border-radius:
        20px;

      font-size:
        .78rem;

      font-weight:
        bold;

      z-index:
        2;
    }

    .informacion h2 {

      font-size:
        clamp(2rem, 4vw, 3rem);

      line-height:
        1.1;

      margin-bottom:
        16px;
    }

    .marca {

      color:
        var(--rojo);

      font-weight:
        900;

      text-transform:
        uppercase;

      letter-spacing:
        2px;

      font-size:
        .85rem;

      margin-bottom:
        8px;
    }

    .descripcion {

      font-size:
        1.08rem;

      color:
        #555;

      margin-bottom:
        22px;
    }

    .beneficios {

      list-style:
        none;

      margin:
        25px 0;
    }

    .beneficios li {

      margin-bottom:
        12px;

      padding-left:
        30px;

      position:
        relative;
    }

    .beneficios li::before {

      content:
        "✓";

      position:
        absolute;

      left:
        0;

      top:
        0;

      color:
        var(--verde);

      font-weight:
        900;
    }

    /* =====================================
       PRECIO
    ====================================== */

    .precio-anterior {

      color:
        #777;

      text-decoration:
        line-through;

      font-size:
        1.05rem;
    }

    .precio-actual {

      color:
        var(--rojo);

      font-size:
        2.2rem;

      font-weight:
        900;

      margin-bottom:
        5px;
    }

    .precio-nota {

      color:
        #666;

      font-size:
        .85rem;

      margin-bottom:
        20px;
    }

    /* =====================================
       BOTONES DE COMPRA
    ====================================== */

    .botones-compra {

      display:
        flex;

      flex-wrap:
        wrap;

      gap:
        12px;

      margin-top:
        10px;
    }

    .cta {

      display:
        inline-block;

      background:
        var(--negro);

      color:
        white;

      padding:
        16px 30px;

      border-radius:
        30px;

      text-decoration:
        none;

      font-weight:
        bold;

      transition:
        .2s ease;
    }

    .cta:hover {

      background:
        var(--rojo);

      transform:
        translateY(-2px);
    }

    .cta-amazon {

      display:
        inline-flex;

      align-items:
        center;

      justify-content:
        center;

      gap:
        8px;

      background:
        #ff9900;

      color:
        #111;

      padding:
        16px 26px;

      border-radius:
        30px;

      text-decoration:
        none;

      font-weight:
        900;

      transition:
        .2s ease;
    }

    .cta-amazon:hover {

      background:
        #ffb52e;

      transform:
        translateY(-2px);
    }

    .amazon-note {

      margin-top:
        12px;

      font-size:
        .78rem;

      color:
        #777;
    }

    /* =====================================
       AMAZON CARD
    ====================================== */

    .amazon-card {

      margin-top:
        30px;

      padding:
        20px;

      border:
        1px solid #ddd;

      border-radius:
        16px;

      background:
        #fafafa;
    }

    .amazon-card-title {

      font-weight:
        900;

      margin-bottom:
        5px;
    }

    .amazon-card p {

      color:
        #666;

      font-size:
        .9rem;

      margin-bottom:
        12px;
    }

    .amazon-link {

      color:
        #0066c0;

      font-weight:
        bold;

      text-decoration:
        none;

      word-break:
        break-all;
    }

    .amazon-link:hover {

      text-decoration:
        underline;
    }

    /* =====================================
       FERIA
    ====================================== */

    .feria {

      margin-top:
        75px;

      padding:
        50px;

      border-radius:
        25px;

      color:
        white;

      background:

        radial-gradient(
          circle at 80% 20%,
          rgba(37, 99, 235, .5),
          transparent 25%
        ),

        linear-gradient(
          135deg,
          #080808,
          #181818
        );

      display:
        grid;

      grid-template-columns:
        1fr 1fr;

      gap:
        35px;

      align-items:
        center;
    }

    .feria h2 {

      font-size:
        clamp(2rem, 4vw, 3rem);

      line-height:
        1.1;

      margin:
        12px 0;
    }

    .feria p {

      color:
        #ddd;

      margin-bottom:
        20px;
    }

    .feria-info {

      display:
        grid;

      gap:
        12px;
    }

    .feria-card {

      padding:
        18px;

      border-radius:
        14px;

      background:
        rgba(255, 255, 255, .08);

      border:
        1px solid
        rgba(255, 255, 255, .12);
    }

    .feria-card strong {

      display:
        block;

      color:
        white;

      margin-bottom:
        3px;
    }

    .feria-card span {

      color:
        #bbb;

      font-size:
        .9rem;
    }

    /* =====================================
       TECNOLOGÍA
    ====================================== */

    .tecnologia {

      margin-top:
        70px;
    }

    .features {

      display:
        grid;

      grid-template-columns:
        repeat(3, 1fr);

      gap:
        20px;
    }

    .feature {

      background:
        var(--gris);

      padding:
        30px;

      border-radius:
        18px;

      text-align:
        center;
    }

    .feature-icon {

      font-size:
        2.2rem;

      margin-bottom:
        12px;
    }

    .feature h3 {

      margin-bottom:
        8px;
    }

    .feature p {

      color:
        #666;

      font-size:
        .95rem;
    }

    /* =====================================
       QR
    ====================================== */

    .qr-section {

      margin-top:
        70px;

      padding:
        40px 25px;

      background:
        var(--gris);

      border-radius:
        22px;

      text-align:
        center;
    }

    .qr-section h2 {

      margin-bottom:
        8px;
    }

    .qr-section p {

      color:
        #666;

      max-width:
        600px;

      margin:
        auto;
    }

    #qrCode {

      display:
        flex;

      justify-content:
        center;

      margin:
        25px auto 10px;
    }

    #qrCode img {

      padding:
        10px;

      background:
        white;

      border-radius:
        10px;
    }

    .qr-help {

      color:
        #777;

      font-size:
        .8rem;
    }

    /* =====================================
       FOOTER
    ====================================== */

    footer {

      margin-top:
        70px;

      padding:
        40px 20px;

      background:
        var(--negro);

      color:
        white;

      text-align:
        center;
    }

    footer strong {

      color:
        #ff3b57;
    }

    footer p {

      color:
        #aaa;

      margin-top:
        8px;

      font-size:
        .9rem;
    }

    /* =====================================
       RESPONSIVE
    ====================================== */

    @media (max-width: 850px) {

      .header-inner {

        flex-direction:
          column;
      }

      nav a {

        margin:
          0 8px;
      }

      .hero {

        min-height:
          560px;

        padding:
          50px 5%;
      }

      .producto,
      .feria {

        grid-template-columns:
          1fr;
      }

      .visor,
      model-viewer {

        min-height:
          430px;

        height:
          430px;
      }

      .features {

        grid-template-columns:
          1fr;
      }

      .feria {

        padding:
          35px 25px;
      }

      .botones-compra {

        flex-direction:
          column;
      }

      .cta,
      .cta-amazon {

        width:
          100%;

        text-align:
          center;
      }
    }

    @media (max-width: 500px) {

      .hero h1 {

        font-size:
          2.5rem;
      }

      .hero p {

        font-size:
          1rem;
      }

      .visor,
      model-viewer {

        height:
          360px;

        min-height:
          360px;
      }

      .precio-actual {

        font-size:
          1.8rem;
      }

      .btn {

        width:
          100%;

        text-align:
          center;
      }

      .ar-button {

        font-size:
          .9rem;

        padding:
          13px 20px;
      }
    }

  </style>
</head>


<body>


  <!-- =====================================
       BARRA PROMOCIONAL
  ====================================== -->

  <div class="top-bar">

    🚀 BogotaFitDeals llega a la próxima
    Feria de Emprendimiento y Tecnología

  </div>


  <!-- =====================================
       HEADER
  ====================================== -->

  <header>

    <div class="header-inner">

      <div class="logo">

        Bogota<span>Fit</span>Deals

      </div>


      <nav>

        <a href="#producto">
          Producto
        </a>

        <a href="#feria">
          Feria
        </a>

        <a href="#experiencia">
          Tecnología
        </a>

        <a href="#qr">
          QR
        </a>

      </nav>

    </div>

  </header>


  <!-- =====================================
       HERO
  ====================================== -->

  <section class="hero">

    <div class="hero-content">

      <span class="etiqueta">

